# `lens agent install codex` writes this entry into .codex/config.toml in
# your repository. Shown here for reference. Codex connects to the
# Streamable HTTP endpoint directly, so no bridge or command is needed.
# The project must be trusted in Codex for .codex/config.toml to load.

[mcp_servers.projectlens]
url = "http://localhost:8484/mcp"
